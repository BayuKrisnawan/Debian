#!/bin/sh
set -e

# 1. Aktifkan service docker bawaan agar jalan saat boot
systemctl enable docker

# 2. Buat Systemd service custom untuk auto-run docker-compose
cat <<'EOF' > /etc/systemd/system/my-app.service
[Unit]
Description=Auto-start Custom Docker Application
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/my-app
ExecStartPre=/usr/bin/docker compose pull --quiet # Jika ada internet
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
EOF

# 3. Registrasikan service ke sistem
systemctl enable my-app.service
